spring.datasource.url=jdbc:postgresql://localhost:5433/notifications_db
spring.datasource.username=autoshop-admin
spring.datasource.password=pass

spring.kafka.bootstrap-servers=localhost:9092
spring.kafka.consumer.group-id=notification-service

spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false

app.kafka.order-events-topic=autoshop.order-events
app.kafka.order-events-dlt-topic=autoshop.order-events.dlt
app.kafka.topic-partitions=1
app.kafka.topic-replicas=1

app.mail.from=noreply@autoshop.local
app.mail.from-name=AutoShop
app.mail.provider=smtp

app.mailjet.api-key=
app.mailjet.api-secret=
app.mailjet.send-url=https://api.mailjet.com/v3.1/send
app.mailjet.sandbox-mode=true
app.mailjet.connect-timeout=2s
app.mailjet.read-timeout=5s

app.retry.email.max-attempts=3
app.retry.email.backoff=500ms
app.retry.kafka.max-attempts=3
app.retry.kafka.backoff=1s
